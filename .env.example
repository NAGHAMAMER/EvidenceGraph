# Application
APP_NAME=EvidenceGraph
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# Backend
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
SECRET_KEY=change-this-in-production
CORS_ORIGINS=http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# PostgreSQL
POSTGRES_DB=evidencegraph
POSTGRES_USER=evidencegraph
POSTGRES_PASSWORD=evidencegraph_dev_password
DATABASE_URL=postgresql+psycopg://evidencegraph:evidencegraph_dev_password@db:5432/evidencegraph

# Scientific research providers
OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_API_KEY=
OPENALEX_EMAIL=your_email@example.com

CROSSREF_BASE_URL=https://api.crossref.org
CROSSREF_EMAIL=your_email@example.com

SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org/graph/v1
SEMANTIC_SCHOLAR_API_KEY=

# NLP
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
AGENT_MAX_PAPERS=10
REQUEST_TIMEOUT_SECONDS=30
EMBEDDING_CACHE_DIR=/models/fastembed

# Optional LLM provider — configured in a later week
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=

# Hugging Face downloads
HF_HUB_DISABLE_XET=1
HF_HUB_DOWNLOAD_TIMEOUT=600
